rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public reads for leaderboard
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if request.auth != null ||
                   (request.resource.data.score > 0 &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 20 &&
                    request.resource.data.difficulty in ['easy', 'normal', 'hard']);
    }
    // Allow public reads and writes for NumberCrunch leaderboard
    match /NumberCrunchLeaderboard/{entry} {
      allow read: if true;
      allow write: if request.auth != null ||
                   (request.resource.data.score > 0 &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 20 &&
                    request.resource.data.difficulty in ['easy', 'normal', 'hard'] &&
                    request.resource.data.level > 0);
    }
    // Allow public reads and writes for NumberCrunch replays
    match /NumberCrunchReplays/{entry} {
      allow read: if true;
      allow write: if request.auth != null ||
                   (request.resource.data.sessionId.size() > 0 &&
                    request.resource.data.target > 0 &&
                    request.resource.data.difficulty in ['easy', 'normal', 'hard'] &&
                    request.resource.data.startTime > 0 &&
                    request.resource.data.endTime > request.resource.data.startTime &&
                    request.resource.data.actions is list &&
                    request.resource.data.actions.size() <= 40 &&
                    request.resource.data.totalDamageDealt >= 0 &&
                    request.resource.data.enemyHealthAtStart > 0 &&
                    request.resource.data.playerHealthAtStart >= 0 &&
                    request.resource.data.gridSeed >= 0 &&
                    request.resource.data.scrambleSeeds is list);
      allow update: if request.auth != null ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerName']) &&
                     request.resource.data.playerName is string &&
                     request.resource.data.playerName.size() > 0 &&
                     request.resource.data.playerName.size() <= 20);
    }
  }
}